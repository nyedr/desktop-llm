# Model Service Settings
OLLAMA_BASE_URLS=["http://localhost:11434"]
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
DEFAULT_MODEL="deepseek/deepseek-chat"
MODEL_TEMPERATURE=0.7
MAX_TOKENS=4096
MAX_CHUNK_TOKENS=1024
CHUNK_SIZE=512
MODEL_REQUEST_TIMEOUT=30
DEFAULT_TEMPERATURE=0.7
RATE_LIMIT="60/minute"
GENERATION_REQUEST_TIMEOUT=300

# Function Settings
FUNCTION_CALLS_ENABLED=true
FUNCTION_EXECUTION_TIMEOUT=30
ENABLE_MODEL_FILTER=false
MODEL_FILTER_LIST=[]

# Logging Settings
LOG_LEVEL="DEBUG"
TOKENIZER_MODEL="gpt2"

# SSE Settings
SSE_PING_INTERVAL=15
SSE_RETRY_TIMEOUT=5000

# LightRAG Settings
LIGHTRAG_DATA_DIR="lightrag_data"
MEMORY_QUEUE_PROCESS_DELAY=0.1
MEMORY_QUEUE_ERROR_RETRY_DELAY=1.0
CLEANUP_INTERVAL=3600
OPTIMIZATION_INTERVAL=7200
MONITORING_INTERVAL=300
DEFAULT_RETENTION_DAYS=30
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
DEFAULT_EMBEDDING_DIM=384